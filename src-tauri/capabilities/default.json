{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main",
    "review-*"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "binaries/tailward-daemon",
          "sidecar": true,
          "args": [
            "--host",
            "127.0.0.1",
            "--port",
            "7878"
          ]
        }
      ]
    }
  ]
}
