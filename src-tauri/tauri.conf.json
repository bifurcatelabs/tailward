{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tailward",
  "version": "0.1.0",
  "identifier": "com.bifurcate.tailward",
  "build": {
    "frontendDist": "../src/tailward/web/static/dist",
    "devUrl": "http://127.0.0.1:7878"
  },
  "app": {
    "windows": [
      {
        "title": "tailward",
        "width": 900,
        "height": 900,
        "minWidth": 480,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/tailward-daemon"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
